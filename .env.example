# === mongodb — пример окружения (скопировать в .env; .env НЕ коммитить) ===
#
# ВАЖНО про формат: docker compose трактует всё после первого "=" как значение.
# Кавычки станут частью значения — не оборачивайте в них пути.

# --- Каталог с данными ----------------------------------------------------------------
# ВНЕ рабочей копии git — намеренно. Каталог проекта на хосте это git-клон, и `git clean -xfd`
# в нём удалил бы базу целиком. Внутри создаются два подкаталога: db/ и configdb/.
#
# Соглашение: код сервиса в /srv/<проект>, данные в /srv/data/<проект>.
# Для прода сюда стоит указать отдельный диск.
MONGO_DATA_DIR=/srv/data/mongodb

# --- Версия ---------------------------------------------------------------------------
# Community-редакция (лицензии на Enterprise нет).
#
# 🔴 Поднять до 5.0+ СЕЙЧАС НЕЛЬЗЯ: MongoDB 5.0 и новее требуют инструкций AVX, а машины
# видят процессор как профиль x86-64-v2-AES (умолчание Proxmox 8), где AVX нет:
# AVX относится к уровню x86-64-v3, а не v2. Нужен тип CPU host или x86-64-v3 — см. README.
# Проверено 10.08.2026: mongo:8.0 падает при старте, mongo:4.4 работает.
# Что нужно, чтобы поднять версию, — см. README.
#
# ЦЕЛЕВАЯ ВЕРСИЯ — 8.0. Данных в базе нет, поэтому переходить можно сразу, без ступеней:
# достаточно поставить здесь 8.0 и сделать `docker compose up -d`. Но только ПОСЛЕ смены
# типа CPU у виртуалки — иначе контейнер не стартует.
MONGO_VERSION=4.4

# --- Сеть ---------------------------------------------------------------------------
# ⚠️ Аутентификации у базы нет, поэтому открытый порт = открытая база.
# Закрытие порта и включение auth вынесены в отдельную задачу (к базе ходит много сервисов).
# Когда дойдёт: поставить MONGO_BIND=127.0.0.1 — сервисам из local-network порт на хосте
# не нужен, они ходят по имени mongodb.
MONGO_PORT=27017
MONGO_BIND=0.0.0.0
